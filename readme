auto run

nano  /etc/systemd/system/ols.service 
add this 
[Unit]
Description=OLS Monitor Startup
After=network.target graphical.target

[Service]
Type=forking
User=palmoil
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/palmoil/.Xauthority
ExecStart=/bin/bash /home/palmoil/stuff/startup.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target


run below for create link

sudo -u palmoil /bin/bash /home/palmoil/stuff/startup.sh
sudo systemctl daemon-reload
sudo systemctl enable ols.service
sudo systemctl restart ols.service
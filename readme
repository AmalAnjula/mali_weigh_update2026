auto run

sudo nano  /etc/systemd/system/ols.service 
add this 
[Unit]
Description=OLS Monitor Startup
After=network.target graphical.target

[Service]
Type=forking
User=palmoil
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/coco_oil_p4/.Xauthority
ExecStart=/bin/bash /home/coco_oil_p4/stuff/startup.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target


run below for create link

